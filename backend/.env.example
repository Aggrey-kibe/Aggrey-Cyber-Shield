# Aggrey Shield backend — Phase 1 environment variables
#
# Copy this file to .env and adjust values for your machine.
# .env is git-ignored — never commit real secrets.
#
# More variables will be added here in later phases:
#   Phase 4  (auth):            JWT_SECRET_KEY, JWT_ALGORITHM, ACCESS_TOKEN_EXPIRE_MINUTES,
#                                REFRESH_TOKEN_EXPIRE_DAYS, ARGON2_* , MFA_ISSUER_NAME
#   Phase 6/7 (email/queues):   REDIS_URL, CELERY_BROKER_URL, SMTP_* / SES config
#   Phase 7  (threat intel):    THREAT_INTEL_SAFE_BROWSING_KEY, THREAT_INTEL_VIRUSTOTAL_KEY
#   Phase 13 (AWS):             AWS_REGION, S3_BUCKET_NAME

# --- General ---
APP_NAME=Aggrey Shield
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://aggreyshield:changeme@localhost:5432/aggreyshield

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO

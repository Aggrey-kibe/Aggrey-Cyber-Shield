# Aggrey Shield backend — environment variables
#
# Copy this file to .env and adjust values for your machine.
# .env is git-ignored — never commit real secrets.
#
# Variables marked REQUIRED have no default: the app will not start without them.

# --- General ---
APP_NAME=Aggrey Shield
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://aggreyshield:changeme@localhost:5432/aggreyshield

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO

# --- Authentication (REQUIRED) ---
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MFA_ISSUER_NAME=AGGREY SHIELD

# --- Email via Resend ---
# RESEND_API_KEY is REQUIRED. Get it from your Resend dashboard. Never commit it.
RESEND_API_KEY=
# The sender must be on a domain you have VERIFIED in Resend before real users
# can receive email. The default onboarding@resend.dev only delivers to the
# email address that owns the Resend account.
EMAIL_FROM=AGGREY SHIELD <onboarding@resend.dev>
# Where the password-reset link in emails points (must be a reachable HTTPS page).
PASSWORD_RESET_URL_BASE=https://aggreykibe.blogspot.com/p/reset-password.html
